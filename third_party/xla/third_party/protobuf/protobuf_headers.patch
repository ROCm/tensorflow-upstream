diff --git a/src/google/protobuf/io/BUILD.bazel b/src/google/protobuf/io/BUILD.bazel
--- a/src/google/protobuf/io/BUILD.bazel
+++ b/src/google/protobuf/io/BUILD.bazel
@@ -255,6 +255,25 @@
 # Distribution packaging
 ################################################################################
 
+# Added by TensorFlow: a header-only view of this package.
+#
+# //src/google/protobuf:protobuf_headers globs "**/*.h", but Bazel globs do not
+# cross package boundaries, so the headers in this subpackage were silently
+# omitted from it. Projects that build shared libraries for dynamic loading
+# (e.g. TensorFlow custom ops) depend on protobuf_headers alone and need these.
+cc_library(
+    name = "io_headers",
+    hdrs = glob(
+        [
+            "**/*.h",
+            "**/*.inc",
+        ],
+        allow_empty = True,
+    ),
+    strip_include_prefix = "/src",
+    visibility = ["//visibility:public"],
+)
+
 pkg_files(
     name = "dist_files",
     srcs = glob(["**/*"]),
